# ─── Copy to .env and fill in. Placeholders marked TODO are required before a real run. ───

# OpenAI (TODO: required)
OPENAI_API_KEY=sk-TODO-your-openai-key

# Models (see docs/model_choice.md for why)
PRIMARY_MODEL=gpt-4.1          # final answers + goal proposals
FAST_MODEL=gpt-4.1-mini        # triage, tool planning, citation judge, vision extraction
FALLBACK_MODEL=gpt-4.1-mini    # used when the primary errors or the daily budget is exceeded
EMBEDDING_MODEL=text-embedding-3-small
DAILY_BUDGET_USD=2.0

# Generation hyperparameters (chosen experimentally, see EVALS.md)
GEN_TEMPERATURE=0.3
GEN_TOP_P=1.0
GEN_MAX_TOKENS=900

# LangSmith tracing (TODO: required for the dashboard)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-TODO-your-langsmith-key
LANGSMITH_PROJECT=cycle-aware-health-coach
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Withings (TODO: from https://developer.withings.com/dashboard/)
WITHINGS_CLIENT_ID=TODO-withings-client-id
WITHINGS_CLIENT_SECRET=TODO-withings-client-secret
WITHINGS_REDIRECT_URI=http://localhost:8000/withings/callback

# Storage
DB_PATH=data/health.db
# Leave QDRANT_URL empty to use embedded Qdrant on disk (no Docker needed)
QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_API_KEY=

# Services
MCP_URL=http://localhost:8001/mcp
FRONTEND_ORIGIN=http://localhost:3000
USER_NAME=Damilya
HOME_LAT=50.85
HOME_LON=4.35
HOME_TZ=Europe/Brussels   # every source is normalised to this timezone
